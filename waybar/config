{
    "layer": "top",
    "position": "top",
    "height": 22,

    "modules-left": [
        "sway/workspaces"
    ],

    "modules-right": [
        "tray",
        "sway/language",
        "pulseaudio",
        "cpu",
        "memory",
        "battery",
        "clock",
        "custom/wifi"
    ],

    "sway/language": {
        "format": "{short}",
        "tooltip": false
    },

    "sway/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "all-outputs": true,
        "format-icons": {
            "default": ""
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "timezone": "Europe/London"
    },

    "pulseaudio": {
        "format": "VOLUME:{volume}%",
        "format-muted": "VOLUME: muted"
    },

    "cpu": {
        "interval": 1,
        "format": "CPU:{usage}%"
    },

    "memory": {
        "interval": 1,
        "format": "RAM:{used:0.1f}G"
    },

    "battery": {
        "bat": "BAT1",
        "interval": 60,
        "format": "BATT:{capacity}%"
    },
    "custom/wifi": {
    "exec": "~/.config/waybar/scripts/wifi.sh",
    "interval": 5,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
}}
